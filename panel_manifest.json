    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/zone-1.webp",
      "role": "zone_1"
    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/zone-2.webp",

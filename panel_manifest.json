    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/zone-4.webp",
      "role": "zone_4"
    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/zone-5.webp",
      "role": "zone_5"
    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/zone-6.webp",
      "role": "zone_6"
    }

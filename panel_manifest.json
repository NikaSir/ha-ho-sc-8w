      "role": "controller_status"
    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/rain-sensor-v5.webp",
      "role": "rain_sensor"
    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/valve-v2.webp",
      "role": "valve"
    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/mainline-node.webp",
      "role": "mainline_status"
    },
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/manifold-v1.webp",

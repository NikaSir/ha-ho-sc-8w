    "1": "lawn",
    "2": "lawn",
    "3": "lawn",
    "4": "flowerbed",
    "5": "shrubs",
    "6": "greenhouse"
  },
  "status_layout": "system_state_connection_pressure_informative_zones_program_mode_seasonal_actions_fit_without_scroll",
  "rain_sensor_connection": "direct_horizontal_midline_to_controller",
  "status_scroll_at_100": false,
  "long_views_native_vertical_scroll_at_100": true,

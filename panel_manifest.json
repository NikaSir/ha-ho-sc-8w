      "Локально",
      "Облако",
      "Резерв",
      "Нет связи",
      "Нет данных"
    ],
    "freshness": [
      "Данные актуальны",
      "Данные устарели",
      "Нет данных"
    ],
    "stable_dom": true
  },
  "static_url": "/nikas-ho-sc-8w/",
  "bundle": "custom_components/nikas_ho_sc_8w/frontend/irrigation-panel.js",
  "asset_policy": {
    "delivery": "integration_owned_static_files",
    "cache_busting": "query_string_version",
    "inline_base64": false,
    "external_hosts": false
  },
  "assets": [
    {
      "path": "custom_components/nikas_ho_sc_8w/frontend/assets/ho-sc-8w-controller-v4.webp",

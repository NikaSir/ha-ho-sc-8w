{
  "panel": {
    "id": "irrigation",
    "title": "Полив",
    "path": "/dashboard-irrigation",
    "parent_path": "/dashboard-actions",
    "icon": "mdi:sprinkler",
    "owner": "ha-ho-sc-8w",
    "expose_in_generated_ui": true,
    "preferred_view": "status",
    "dashboard_version": "0.6.9",
    "navigation": {
      "header_left": "home_assistant_sidebar_menu",
      "header_menu_event": "hass-toggle-menu",
      "header_right": "refresh",
      "primary_navigation": "full_width_fixed_bottom_tab_bar",
      "browser_history_back": false,
      "views": [
        "status",
        "zones",
        "program",
        "manual",
        "diagnostics"
      ]
    },
    "frontend": {
      "bundle": "integration_owned_local_assets",
      "module_url": "/nikas-ho-sc-8w/irrigation-panel.js",
      "static_url": "/nikas-ho-sc-8w/",
      "asset_manifest": "panel_manifest.json",
      "cache_busting": "query_string_version",
      "inline_base64_images": false,
      "external_image_hosts": false,
      "historical_runtime_imports": false
    },
    "status_layout": {
      "reference": "approved_system_state_render",
      "sections": [
        "system_state",
        "program_mode_telemetry",
        "primary_actions",
        "statuses"
      ]
    },
    "system_visualization": {
      "controller": "INKBIRD / HiOazo HO-SC-8W with LCD and Wi-Fi",
      "production_zones": [1, 2, 3, 4, 5, 6],
      "zone_8": "diagnostics_only",
      "hydraulic_path": "incoming_mainline_to_manifold_to_valves_to_zones",
      "mainline_connection_side": "left_direct_to_manifold",
      "electrical_path": "controller_to_valve_actuators",
      "rain_sensor_path": "rain_sensor_to_controller",
      "water_passes_through_controller": false,
      "zone_routing": "orthogonal_vertical_one_to_one",
      "mobile_layout": "approved_light_reference_with_11px_copy_floor",
      "manifold_layout": "single_six_column_grid_with_shared_valve_pipe_zone_axes",
      "mainline_pressure_presentation": "text_only_two_decimal_bar_value_below_connection_status",
      "mainline_state": "sensor.nikas_h2000_pro_voda_na_poliv_2",
      "mainline_state_source_verified": true,
      "dynamic_state_source": "home_assistant_entities",
      "zone_scene_thumbnails": "approved_reference_local_webp",
      "theme_strategy": "fixed_light_reference_dark_theme_deferred",
      "content_zoom": {
        "engine": "single_transform_canvas_pointer_events_v2",
        "default_percent": 100,
        "reset_percent": 100,
        "minimum_percent": 75,
        "maximum_percent": 200,
        "controls": "two_finger_pinch_and_two_finger_double_tap_reset",
        "permanent_onscreen_controls": false,
        "scope": "single_work_canvas_only_header_and_bottom_navigation_native",
        "pinch_origin": "touch_midpoint",
        "pan_when_enlarged": true,
        "snap_to_100_percent": [97, 103],
        "persist_per_panel_client_and_view": true,
        "shell_reconciliation": "idempotent"
      }
    }
  },
  "ownership": {
    "direct_tuya_dp_writes_from_ui": false,
    "unverified_control_actions": false,
    "unknown_unavailable_are_healthy": false
  },
  "standards": {
    "integration_panel_template": "NikaS specialized panel variant",
    "header": "ha_sidebar_menu_centered_title_refresh"
  }
